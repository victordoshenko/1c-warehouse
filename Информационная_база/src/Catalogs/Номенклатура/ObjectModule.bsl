Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если ПустаяСтрока(Артикул) Тогда
        Отказ = Истина;
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Артикул обязателен для заполнения";
        Сообщение.Сообщить();
    КонецЕсли;
    
    Если Цена < 0 Тогда
        Отказ = Истина;
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Цена не может быть отрицательной";
        Сообщение.Сообщить();
    КонецЕсли;
КонецПроцедуры