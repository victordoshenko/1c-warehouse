Функция ПодготовитьДанныеДляОтправки() Экспорт
    // Выбираем первые 5 товаров (чтобы не перегружать тестовый запрос)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 5
        |   Номенклатура.Ссылка КАК Ссылка,
        |   Номенклатура.Артикул КАК Артикул,
        |   Номенклатура.Наименование КАК Наименование,
        |   Номенклатура.Цена КАК Цена
        |ИЗ
        |   Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |   Номенклатура.ПометкаУдаления = ЛОЖЬ";
    
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Новый Массив; // Нет данных
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    МассивТоваров = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        Товар = Новый Структура;
        Товар.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
        Товар.Вставить("article", Выборка.Артикул);
        Товар.Вставить("name", Выборка.Наименование);
        Товар.Вставить("price", Выборка.Цена);
        МассивТоваров.Добавить(Товар);
    КонецЦикла;
    
    Возврат МассивТоваров;
КонецФункции

Функция СериализоватьВJSON(Данные) Экспорт
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ОтправитьДанныеНаСервер(ДанныеJSON) Экспорт
    // 1. Параметры подключения
    Сервер = "httpbin.org";
    Порт = 443;
    Таймаут = 30; // секунды — обязательно!
    
    // 2. Защищённое соединение для HTTPS
    Защита = Новый ЗащищенноеСоединениеOpenSSL();
    
    Результат = Новый Структура("Успех, Ответ, Ошибка", Ложь, "", "");
    
    Попытка
        // 3. Создаём соединение
        Соединение = Новый HTTPСоединение(
            Сервер, Порт, , , , Таймаут, Защита);
        
        // 4. Создаём запрос
        Запрос = Новый HTTPЗапрос("/post");
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(ДанныеJSON, КодировкаТекста.UTF8, 
            ИспользованиеByteOrderMark.НеИспользовать);
        
        // 5. Отправляем
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        
        // 6. Анализируем код состояния
        Если Ответ.КодСостояния = 200 Тогда
            Результат.Успех = Истина;
            Результат.Ответ = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
        Иначе
            Результат.Ошибка = "HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
        КонецЕсли;
        
    Исключение
        Результат.Ошибка = "Сетевая ошибка: " + ОписаниеОшибки();
    КонецПопытки;
    
    Возврат Результат;
КонецФункции

Функция РазобратьОтвет(ОтветJSON) Экспорт
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ОтветJSON);
    Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
    ЧтениеJSON.Закрыть();
    
    Результат = Новый Массив;
    
    ЗначениеJSON = Данные.Получить("json");
    Если ЗначениеJSON <> Неопределено И ТипЗнч(ЗначениеJSON) = Тип("Массив") Тогда
        Для Каждого Элемент Из ЗначениеJSON Цикл
            // Элемент — это Соответствие с ключами article, id, name, price
            Строка = "Артикул: " + Элемент.Получить("article") 
                + " | Наименование: " + Элемент.Получить("name")
                + " | Цена: " + Элемент.Получить("price");
            Результат.Добавить(Строка);
        КонецЦикла;
    КонецЕсли;
    
    Если Результат.Количество() = 0 Тогда
        Возврат "Данные не найдены в ответе";
    КонецЕсли;
    
    Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция ОтформатироватьJSON(СыройJSON) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СыройJSON);
    Данные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    
    // Создаём новое Соответствие для результата
    Результат = Новый Соответствие;
    
    Для Каждого КлючИЗначение Из Данные Цикл
        Ключ = КлючИЗначение.Ключ;
        Значение = КлючИЗначение.Значение;
        
        Если Ключ = "data" И ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 0 Тогда
            // Пробуем распарсить data как JSON
            Попытка
                ЧтениеData = Новый ЧтениеJSON;
                ЧтениеData.УстановитьСтроку(Значение);
                Распарсенное = ПрочитатьJSON(ЧтениеData, Истина);
                ЧтениеData.Закрыть();
                Результат.Вставить(Ключ, Распарсенное);
            Исключение
                // Если не удалось — оставляем строку как есть
                Результат.Вставить(Ключ, Значение);
            КонецПопытки;
        Иначе
            Результат.Вставить(Ключ, Значение);
        КонецЕсли;
    КонецЦикла;
    
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Результат);
    Возврат Запись.Закрыть();
КонецФункции

&НаКлиенте
Процедура ОтправитьДанные(Команда)
    Результат = ОтправитьДанныеНаСервере();
    Если Результат.Успех Тогда
        ПолеРезультат = ОтформатироватьJSON(Результат.Ответ); // Присваиваем реквизиту, не элементу!
    Иначе
        ПолеРезультат = "Ошибка: " + Результат.Ошибка;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОтправитьДанныеНаСервере()
    Данные = ПодготовитьДанныеДляОтправки();
    Если Данные.Количество() = 0 Тогда
        Возврат Новый Структура("Успех, Ответ, Ошибка", Ложь, "", "Нет данных для отправки");
    КонецЕсли;
    
    JSON = СериализоватьВJSON(Данные);
    Результат = ОтправитьДанныеНаСервер(JSON);
    
    Если Результат.Успех Тогда
        Разобранные = РазобратьОтвет(Результат.Ответ);
        // Здесь можно записать лог в регистр сведений или обновить поле
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

