&НаКлиенте
Процедура ЗаполнитьБазу(Команда)
    // Сначала полная очистка — чтобы не было «хвостов» от прошлых запусков
    ОчиститьРегистрПоРегистраторам();
    ОчиститьСправочникПорциями();
    
    ВсегоПорций = 3;
    РазмерПорции = 1000;
	
    Для НомерПорции = 1 По ВсегоПорций Цикл
        ЗаполнитьПорциюНаСервере(НомерПорции, РазмерПорции);
        ПолеСтатус = "Заполнено: " + (НомерПорции * РазмерПорции) + " из " + (ВсегоПорций * РазмерПорции);
        
        ПоказатьОповещениеПользователя(
            "Генерация данных", // Короткий заголовок
            , // Навигационная ссылка не нужна
            "Создано товаров: " + (НомерПорции * РазмерПорции) + " из " + (ВсегоПорций * РазмерПорции) // Пояснение
        );
    КонецЦикла;
    
    // Проверяем реальное количество записей
    ПроверитьКоличествоЗаписей();
    
    ПолеСтатус = "Готово! Генерация завершена. Результаты проверки — в сообщениях.";
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьБазу(Команда)
    ОчиститьРегистрПоРегистраторам();
    ОчиститьСправочникПорциями();
    ПолеСтатус = "База очищена.";
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСправочникПорциями()
    ВсегоЭлементов = ПолучитьКоличествоТоваров();
    Если ВсегоЭлементов = 0 Тогда
        ПолеСтатус = "Справочник уже пуст.";
        Возврат;
    КонецЕсли;
    
    РазмерПорции = 5000;
    ВсегоПорций = Цел(ВсегоЭлементов / РазмерПорции) + 1;
    
    Для НомерПорции = 1 По ВсегоПорций Цикл
        УдаленоВПорции = УдалитьПорциюСправочника(РазмерПорции);
        
        Если УдаленоВПорции = 0 Тогда
            Прервать;
        КонецЕсли;
        
        ПолеСтатус = "Очистка справочника: удалено " + (НомерПорции * РазмерПорции) + " из ~" + ВсегоЭлементов;
        
        ПоказатьОповещениеПользователя(
            "Очистка справочника", // Короткий заголовок
            , // Навигационная ссылка не нужна
            "Удалено: " + (НомерПорции * РазмерПорции) + " из ~" + ВсегоЭлементов // Пояснение
        );
    КонецЦикла;
    
    Сообщить("Справочник Номенклатура очищен.");
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоТоваров()
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   КОЛИЧЕСТВО(*) КАК ВсегоТоваров
        |ИЗ
        |   Справочник.Номенклатура";
    Результат = Запрос.Выполнить().Выбрать();
    Результат.Следующий();
    Возврат Результат.ВсегоТоваров;
КонецФункции

&НаСервере
Функция УдалитьПорциюСправочника(РазмерПорции)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПорции, "ЧГ=0") + "
        |   Номенклатура.Ссылка КАК Ссылка
        |ИЗ
        |   Справочник.Номенклатура КАК Номенклатура";
    
    Выборка = Запрос.Выполнить().Выбрать();
    Количество = 0;
    
    Пока Выборка.Следующий() Цикл
        ТоварОбъект = Выборка.Ссылка.ПолучитьОбъект();
        Если ТоварОбъект <> Неопределено Тогда
            ТоварОбъект.Удалить();
            Количество = Количество + 1;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Количество;
КонецФункции

&НаСервере
Процедура ЗаполнитьПорциюНаСервере(НомерПорции, РазмерПорции)
    НачалоИндекс = (НомерПорции - 1) * РазмерПорции + 1;
    КонецИндекс = НомерПорции * РазмерПорции;
    
    // Создаём СВОЙ фиктивный документ для этой порции,
    // чтобы движения не замещали друг друга
    ФиктивныйДокумент = Документы.ПоступлениеТоваров.СоздатьДокумент();
    ФиктивныйДокумент.Дата = ТекущаяДата();
    ФиктивныйДокумент.Записать();
    
    // 1. Создаём товары для этой порции
    МассивСсылок = Новый Массив;
    
    Для Индекс = НачалоИндекс По КонецИндекс Цикл
        НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
        НовыйЭлемент.Артикул = "ART-" + Формат(Индекс, "ЧГ=0");
        НовыйЭлемент.Наименование = "Тестовый товар " + Индекс;
        НовыйЭлемент.Цена = Индекс % 1000;
        НовыйЭлемент.Записать();
        МассивСсылок.Добавить(НовыйЭлемент.Ссылка);
    КонецЦикла;
    
    // 2. Создаём движения регистра — ТОЛЬКО ДЛЯ КАЖДОГО ПЯТОГО ТОВАРА
    НаборЗаписей = РегистрыНакопления.ОстаткиТоваров.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Регистратор.Значение = ФиктивныйДокумент.Ссылка;
    НаборЗаписей.Отбор.Регистратор.Использование = Истина;
    НаборЗаписей.Записывать = Истина;
    
    СчетчикТоваров = 0;
    Для Каждого СсылкаНаТовар Из МассивСсылок Цикл
        СчетчикТоваров = СчетчикТоваров + 1;
        
        // Движение создаём только для каждого 5-го товара
        Если СчетчикТоваров % 5 = 0 Тогда
            Движение = НаборЗаписей.Добавить();
            Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
            Движение.Период = ТекущаяДата();
            Движение.Номенклатура = СсылкаНаТовар;
            Движение.Количество = 10;
            Движение.Сумма = 1000;
        КонецЕсли;
    КонецЦикла;
    
    НаборЗаписей.Записать();
КонецПроцедуры

&НаСервере
Процедура ОчиститьРегистрПоРегистраторам()
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ОстаткиТоваров.Регистратор КАК Регистратор
        |ИЗ
        |   РегистрНакопления.ОстаткиТоваров КАК ОстаткиТоваров";
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        НаборЗаписей = РегистрыНакопления.ОстаткиТоваров.СоздатьНаборЗаписей();
        НаборЗаписей.Отбор.Регистратор.Значение = Выборка.Регистратор;
        НаборЗаписей.Отбор.Регистратор.Использование = Истина;
        НаборЗаписей.Записать();
    КонецЦикла;
    
    Сообщить("Регистр ОстаткиТоваров очищен.");
КонецПроцедуры

&НаСервере
Процедура ПроверитьКоличествоЗаписей()
    Запрос1 = Новый Запрос;
    Запрос1.Текст = 
        "ВЫБРАТЬ
        |   КОЛИЧЕСТВО(*) КАК ВсегоТоваров
        |ИЗ
        |   Справочник.Номенклатура";
    Результат1 = Запрос1.Выполнить().Выбрать();
    Результат1.Следующий();
    ВсегоТоваров = Результат1.ВсегоТоваров;
    
    Запрос2 = Новый Запрос;
    Запрос2.Текст = 
        "ВЫБРАТЬ
        |   КОЛИЧЕСТВО(*) КАК ВсегоДвижений
        |ИЗ
        |   РегистрНакопления.ОстаткиТоваров";
    Результат2 = Запрос2.Выполнить().Выбрать();
    Результат2.Следующий();
    ВсегоДвижений = Результат2.ВсегоДвижений;
    
    Сообщить("=== ПРОВЕРКА КОЛИЧЕСТВА ЗАПИСЕЙ ===");
    Сообщить("Товаров в справочнике Номенклатура: " + ВсегоТоваров);
    Сообщить("Движений в регистре ОстаткиТоваров: " + ВсегоДвижений);
    
    Если ВсегоТоваров = 3000 И ВсегоДвижений = 600 Тогда
        Сообщить("Результат: ОК (3 000 товаров и 600 движений)");
    Иначе
        Сообщить("Результат: ВНИМАНИЕ! Количество отличается от ожидаемого (3 000 товаров / 600 движений)");
    КонецЕсли;
КонецПроцедуры